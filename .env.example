# ============================================================
# AI Narrative World Engine — configuration
# 复制为 .env 后修改。禁止把真实 API Key 提交到仓库。
# ============================================================

APP_ENV=dev
DEBUG_MODE=true
LOG_LEVEL=INFO
LOG_JSON=false

# ------------------------------------------------------------
# Database
#   dev/test : sqlite+aiosqlite:///./data/game.db
#   prod     : postgresql+asyncpg://user:pass@host:5432/aiworld
# ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/game.db
DATABASE_ECHO=false

# 可选。留空则使用进程内锁与进程内幂等存储。
REDIS_URL=

# ------------------------------------------------------------
# Content pack
# ------------------------------------------------------------
CONTENT_PACK=cultivation_v1
CONTENT_DIR=./content

# ------------------------------------------------------------
# LLM
#   LLM_PROVIDER: null | anthropic | openai | compatible | scripted
#   null = 不调用任何模型，全部走确定性 fallback（世界引擎仍完整可用）
# ------------------------------------------------------------
LLM_PROVIDER=null

# 推荐的统一配置：所有文字角色默认共用一个模型。
# 一个 Key 填 LLM_API_KEY；多个 Key 填 LLM_API_KEYS，以逗号分隔。
# Key 池会轮询分配并发请求；它不会缩短同一回合中有前后依赖的阶段。
LLM_API_KEY=
LLM_API_KEYS=
LLM_BASE_URL=
LLM_MODEL=

# 以下是兼容旧版本的厂商字段。使用上面的统一配置时无需填写。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenAI 兼容端点（DeepSeek / Qwen / vLLM / Ollama / OneAPI ...）
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# ------------------------------------------------------------
# Model routing (§48) —— 代码中不得硬编码任何模型名
# ------------------------------------------------------------
# 以下均为可选覆盖；留空时沿用 LLM_MODEL。
# 世界管家（把玩家提到但世界里没有的人/地点补进世界）。
STEWARD_MODEL=

INTENT_MODEL=
NPC_MODEL=
NPC_MAJOR_MODEL=
DIRECTOR_MODEL=
NARRATIVE_MODEL=
MEMORY_MODEL=
EMBEDDING_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_REPAIRS=2

# 空响应（输出预算被推理过程吃光）时自动加倍预算重试的次数。
LLM_TRUNCATION_RETRIES=2
# 所有角色输出预算的统一倍率。推理模型建议 1.5—2.0。
LLM_OUTPUT_BUDGET_SCALE=1.0
# 逐字合并进请求体的 JSON。厂商开关写在这里，代码里不出现任何厂商名。
#   关闭思考模式可大幅降低延迟，具体字段名以你的端点文档为准，例如：
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY=

# ------------------------------------------------------------
# Prompt versions (§46) —— A/B 测试用
# ------------------------------------------------------------
PROMPT_VERSION_PLAYER_INTENT=v1
PROMPT_VERSION_NPC_DECISION=v1
PROMPT_VERSION_DIRECTOR=v1
PROMPT_VERSION_NARRATIVE=v1
PROMPT_VERSION_MEMORY_EXTRACTOR=v1

# ------------------------------------------------------------
# Context token budgets (§29)
# ------------------------------------------------------------
CTX_BUDGET_INTENT=2600
CTX_BUDGET_NPC=2500
CTX_BUDGET_DIRECTOR=3000
CTX_BUDGET_NARRATIVE=7000
CTX_BUDGET_MEMORY=1200

# ------------------------------------------------------------
# Simulation
# ------------------------------------------------------------
# 0 = use the content pack's action-duration limit. Positive values reject
# larger jumps; the simulator never silently processes less time than the clock.
SIM_MAX_OFFLINE_MINUTES=0
DIRECTOR_MIN_INTERVAL_TURNS=3

# ------------------------------------------------------------
# Embeddings
#   EMBEDDING_BACKEND: hash | llm
#   hash = 确定性本地哈希向量，无需网络（默认，测试友好）
# ------------------------------------------------------------
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=256

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=*
