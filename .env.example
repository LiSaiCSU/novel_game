# ============================================================
# AI Narrative World Engine — configuration
# 复制为 .env 后修改。禁止把真实 API Key 提交到仓库。
# ============================================================

APP_ENV=dev
DEBUG_MODE=true
LOG_LEVEL=INFO
LOG_JSON=false

# ------------------------------------------------------------
# Database
#   dev/test : sqlite+aiosqlite:///./data/game.db
#   prod     : postgresql+asyncpg://user:pass@host:5432/aiworld
# ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/game.db
DATABASE_ECHO=false

# 可选。留空则使用进程内锁与进程内幂等存储。
REDIS_URL=

# ------------------------------------------------------------
# Content pack
# ------------------------------------------------------------
CONTENT_PACK=cultivation_v1
CONTENT_DIR=./content

# ------------------------------------------------------------
# LLM
#   LLM_PROVIDER: null | anthropic | openai | compatible | scripted
#   null = 不调用任何模型，全部走确定性 fallback（世界引擎仍完整可用）
# ------------------------------------------------------------
LLM_PROVIDER=null

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenAI 兼容端点（DeepSeek / Qwen / vLLM / Ollama / OneAPI ...）
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# ------------------------------------------------------------
# Model routing (§48) —— 代码中不得硬编码任何模型名
# ------------------------------------------------------------
INTENT_MODEL=
NPC_MODEL=
NPC_MAJOR_MODEL=
DIRECTOR_MODEL=
NARRATIVE_MODEL=
MEMORY_MODEL=
EMBEDDING_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_REPAIRS=2

# ------------------------------------------------------------
# Prompt versions (§46) —— A/B 测试用
# ------------------------------------------------------------
PROMPT_VERSION_PLAYER_INTENT=v1
PROMPT_VERSION_NPC_DECISION=v1
PROMPT_VERSION_DIRECTOR=v1
PROMPT_VERSION_NARRATIVE=v1
PROMPT_VERSION_MEMORY_EXTRACTOR=v1

# ------------------------------------------------------------
# Context token budgets (§29)
# ------------------------------------------------------------
CTX_BUDGET_INTENT=1200
CTX_BUDGET_NPC=2500
CTX_BUDGET_DIRECTOR=3000
CTX_BUDGET_NARRATIVE=3500
CTX_BUDGET_MEMORY=1200

# ------------------------------------------------------------
# Simulation
# ------------------------------------------------------------
SIM_MAX_OFFLINE_MINUTES=525600
DIRECTOR_MIN_INTERVAL_TURNS=3

# ------------------------------------------------------------
# Embeddings
#   EMBEDDING_BACKEND: hash | llm
#   hash = 确定性本地哈希向量，无需网络（默认，测试友好）
# ------------------------------------------------------------
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=256

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=*
