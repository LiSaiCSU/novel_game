# AI Narrative World Engine — local development defaults
# Copy to .env for development. Never commit production secrets.

APP_ENV=dev
DEBUG_MODE=true
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SLOW_QUERY_SECONDS=0.3
ADMIN_MFA_REQUIRED=true
MFA_STEP_UP_MINUTES=720
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
# Microunits of the billing currency per one million tokens. Keep current
# production prices in deployment configuration; do not guess missing prices.
LLM_PRICE_TABLE={}
LLM_DAILY_COST_ALERT_MICROUNITS=0

DATABASE_URL=sqlite+aiosqlite:///./data/game.db
DATABASE_ECHO=false
REDIS_URL=

CONTENT_PACK=cultivation_v1
CONTENT_DIR=./content

# null | anthropic | openai | compatible | scripted
LLM_PROVIDER=null
LLM_API_KEY=
LLM_API_KEYS=
LLM_BASE_URL=
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

INTENT_MODEL=
NPC_MODEL=
NPC_MAJOR_MODEL=
DIRECTOR_MODEL=
STEWARD_MODEL=
NARRATIVE_MODEL=
MEMORY_MODEL=
EMBEDDING_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_REPAIRS=2
LLM_TRUNCATION_RETRIES=2
LLM_TURN_TOKEN_LIMIT=20000
LLM_DAILY_TOKEN_LIMIT=80000
LLM_MONTHLY_TOKEN_LIMIT=200000
LLM_OUTPUT_BUDGET_SCALE=1.0
LLM_EXTRA_BODY=

PROMPT_VERSION_PLAYER_INTENT=v1
PROMPT_VERSION_NPC_DECISION=v1
PROMPT_VERSION_DIRECTOR=v1
PROMPT_VERSION_WORLD_STEWARD=v1
PROMPT_VERSION_AUTOPILOT=v1
PROMPT_VERSION_PROLOGUE=v1
PROMPT_VERSION_CHAPTER=v1
PROMPT_VERSION_NARRATIVE=v1
PROMPT_VERSION_MEMORY_EXTRACTOR=v1

CTX_BUDGET_INTENT=2600
CTX_BUDGET_NPC=2500
CTX_BUDGET_DIRECTOR=3000
CTX_BUDGET_NARRATIVE=7000
CTX_BUDGET_MEMORY=1200

SIM_MAX_OFFLINE_MINUTES=0
DIRECTOR_MIN_INTERVAL_TURNS=3
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=256

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

AUTH_COOKIE_NAME=ng_session
CSRF_COOKIE_NAME=ng_csrf
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
EMAIL_TOKEN_MINUTES=30
AUTH_PEPPER=change-me-in-production
CREDENTIAL_ENCRYPTION_KEY=
REQUIRE_VERIFIED_EMAIL=true
ADULT_CATALOG_ENABLED=false

OBJECT_STORE_BACKEND=local
ASSETS_DIR=./data/assets
S3_ENDPOINT_URL=
S3_BUCKET=narrative-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Mailpit in compose.yaml listens on 1025 without TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@narrative.local
SMTP_STARTTLS=false
